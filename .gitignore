# Local agent/tool state
.omo/
.playwright-mcp/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs and temporary files
*.log
*.tmp

# KNIME local metadata/cache
*.knimeLock
.metadata/

# Node-RED runtime artifacts (keep flows.json / package.json / settings.js versioned)
node-red/data/node_modules/
node-red/data/.config.*.json
node-red/data/lib/
node-red/data/.npm/
node-red/data/.package-lock.json
node-red/data/package-lock.json
node-red/data/flows_cred.json
node-red/data/.sessions.json
node-red/data/sessions.json
node-red/data/*.backup
# Raw extracted files written by the flows (e.g. airports.xml ~56 MB)
node-red/data/raw/

# Python helper scripts/cache, if used later
__pycache__/
*.pyc
.venv/
venv/
